# Arquivo de variáveis de ambiente para Docker
# Database Configuration (MongoDB local no container)
MONGODB_URI=mongodb://mongodb:27017/space_database

# Server Configuration
PORT=3000

# JWT Configuration (mantido para compatibilidade)
JWT_SECRET=your-super-secret-jwt-key-here

# AWS Cognito Configuration
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=your-user-pool-id-here
COGNITO_CLIENT_ID=your-client-id-here
COGNITO_CLIENT_SECRET=your-client-secret-here
COGNITO_DOMAIN=your-cognito-domain.auth.us-east-1.amazoncognito.com

# Node Environment
NODE_ENV=development

# Configurações de conexão do banco
DB_HOST=mongodb
DB_PORT=27017
DB_NAME=space_database